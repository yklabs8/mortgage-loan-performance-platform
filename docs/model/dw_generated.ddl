CREATE TABLE DIM_LOAN 
    ( 
     CLASSIC_FICO                         NUMBER , 
     FIRST_PAYMENT_DATE                   DATE , 
     FIRST_TIME_HOMEBUYER_INDICATOR       VARCHAR2 (1) , 
     MATURITY_DATE                        DATE , 
     MSA_CODE                             VARCHAR2 (5) , 
     MORTGAGE_INSURANCE_PERCENTAGE_MI     NUMBER , 
     NUMBER_OF_UNITS                      NUMBER , 
     OCCUPANCY_STATUS                     VARCHAR2 (1) , 
     ORIGINAL_COMBINED_LOAN_TO_VALUE_CLTV NUMBER , 
     ORIGINAL_DEBT_TO_INCOME_DTI_RATIO    NUMBER , 
     ORIGINAL_UPB                         NUMBER , 
     ORIGINAL_LOAN_TO_VALUE_LTV           NUMBER , 
     ORIGINAL_INTEREST_RATE               NUMBER , 
     CHANNEL                              VARCHAR2 (1) , 
     PREPAYMENT_PENALTY_INDICATOR         VARCHAR2 (1) , 
     AMORTIZATION_TYPE                    VARCHAR2 (5) , 
     PROPERTY_STATE                       VARCHAR2 (2) , 
     PROPERTY_TYPE                        VARCHAR2 (2) , 
     POSTAL_CODE                          VARCHAR2 (3) , 
     LOAN_IDENTIFIER                      VARCHAR2 (12) , 
     LOAN_PURPOSE                         VARCHAR2 (1) , 
     ORIGINAL_LOAN_TERM                   NUMBER , 
     NUMBER_OF_BORROWERS                  NUMBER , 
     SELLER_NAME                          VARCHAR2 (60) , 
     SUPER_CONFORMING_FLAG                VARCHAR2 (1) , 
     PRE_HARP_LOAN_SEQUENCE_NUMBER        VARCHAR2 (12) , 
     SPECIAL_ELIGIBILITY_PROGRAM          VARCHAR2 (1) , 
     HARP_INDICATOR                       VARCHAR2 (1) , 
     PROPERTY_VALUATION_METHOD            VARCHAR2 (1) , 
     INTEREST_ONLY_I_O_INDICATOR          VARCHAR2 (1) , 
     VANTAGESCORE_4_0                     NUMBER , 
     ORIGINATION_YEAR                     NUMBER (4) , 
     ORIGINATION_QUARTER                  NUMBER (1) , 
     RELEASE_ID                           VARCHAR2 (10)  NOT NULL , 
     DATA_SOURCE                          VARCHAR2 (3)  NOT NULL , 
     LOAN_KEY                             NUMBER GENERATED ALWAYS AS IDENTITY 
        ( START WITH 1 NOCACHE )  NOT NULL , 
     LOAN_DURABLE_KEY                     NUMBER  NOT NULL , 
     FICO_BAND                            VARCHAR2 (12) AS ( CASE WHEN ("CLASSIC_FICO" IS NULL OR "CLASSIC_FICO"=9999) THEN 'UNKNOWN' WHEN "CLASSIC_FICO"<620 THEN '<620' WHEN "CLASSIC_FICO"<680 THEN '[620,680)' WHEN "CLASSIC_FICO"<740 THEN '[680,740)' ELSE '>=740' END ) VIRTUAL , 
     LTV_BAND                             VARCHAR2 (12) AS ( CASE WHEN ("ORIGINAL_LOAN_TO_VALUE_LTV" IS NULL OR "ORIGINAL_LOAN_TO_VALUE_LTV"=999) THEN 'UNKNOWN' WHEN "ORIGINAL_LOAN_TO_VALUE_LTV"<=60 THEN '<=60' WHEN "ORIGINAL_LOAN_TO_VALUE_LTV"<=80 THEN '(60,80]' WHEN "ORIGINAL_LOAN_TO_VALUE_LTV"<=90 THEN '(80,90]' WHEN "ORIGINAL_LOAN_TO_VALUE_LTV"<=97 THEN '(90,97]' ELSE '>97' END ) VIRTUAL , 
     COMPARABLE_FLAG                      VARCHAR2 (1) DEFAULT 'Y'  NOT NULL 
    ) 
;

