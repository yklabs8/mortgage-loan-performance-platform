tring" name="[Calc_transition]" role="dimension" type="nominal"><calculation class='tableau' formula='[from_state] + " → " + [to_state]' /></column><column caption="Loans in from state (all months)" datatype="integer" name="[Calc_from_total_all]" role="measure" type="quantitative"><calculation class='tableau' formula="{FIXED [from_state] : SUM([loan_count])}" /></column><column caption="Loans in from state (month)" datatype="integer" name="[Calc_from_total_month]" role="measure" type="quantitative"><calculation class='tableau' formula="{FIXED [monthly_reporting_period], [from_state] : SUM([loan_count])}" /></column><column caption="Roll rate" datatype="real" default-format="p0.0%" name="[Calc_roll_all]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([loan_count]) / AVG([Calc_from_total_all])" /></column><column caption="Monthly roll rate" datatype="real" default-format="p0.0%" name="[Calc_roll_month]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([loan_count]) / AVG([Calc_from_total_month])" /></column><column-instance column="[monthly_reporting_period]" derivation="Month-Trunc" name="[tmn:monthly_reporting_period:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_transition]" derivation="None" name="[none:Calc_transition:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_roll_month]" derivation="User" name="[usr:Calc_roll_month:qk]" pivot='key' type="quantitative" /></datasource-dependencies><filter class='categorical' column="[federated.trans].[none:Calc_transition:nk]"><groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'><groupfilter function='member' level="[none:Calc_transition:nk]" member='"C → 30"' /><groupfilter function='member' level="[none:Calc_transition:nk]" member='"30 → 60"' /><groupfilter function='member' level="[none:Calc_transition:nk]" member='"60 → 90"' /><groupfilter function='member' level=