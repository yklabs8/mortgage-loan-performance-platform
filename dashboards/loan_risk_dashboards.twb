der]), 2) + " " + [from_state]' /></column><column caption="To state" datatype="string" name="[Calc_to]" role="dimension" type="nominal"><calculation class='tableau' formula='RIGHT("0" + STR([to_state_order]), 2) + " " + [to_state]' /></column><column caption="Transition" datatype="string" name="[Calc_transition]" role="dimension" type="nominal"><calculation class='tableau' formula='[from_state] + " → " + [to_state]' /></column><column caption="Loans in from state (all months)" datatype="integer" name="[Calc_from_total_all]" role="measure" type="quantitative"><calculation class='tableau' formula="{FIXED [from_state] : SUM([loan_count])}" /></column><column caption="Loans in from state (month)" datatype="integer" name="[Calc_from_total_month]" role="measure" type="quantitative"><calculation class='tableau' formula="{FIXED [monthly_reporting_period], [from_state] : SUM([loan_count])}" /></column><column caption="Roll rate" datatype="real" default-format="p0.0%" name="[Calc_roll_all]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([loan_count]) / AVG([Calc_from_total_all])" /></column><column caption="Monthly roll rate" datatype="real" default-format="p0.0%" name="[Calc_roll_month]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([loan_count]) / AVG([Calc_from_total_month])" /></column></datasource><datasource caption="ads_vintage_dlq60_curve.csv" inline='true' name='federated.curve' version='18.1'><connection class='federated'><named-connections><named-connection caption="ads_vintage_dlq60_curve.csv" name='textscan.curve'><connection class='textscan' directory="data" filename="ads_vintage_dlq60_curve.csv" password='' server='' /></named-connection></named-connections><relation connection='textscan.curve' name="ads_vintage_dlq60_curve.csv" table="[ads_vintage_dlq60_curve#csv]" type='table'><columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype="string" name="origination_year" 