ear] + "Q" + [origination_quarter]' /></column><column caption="Cum 60+ rate" datatype="real" default-format="p0.0%" name="[Calc_rate]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([cum_dlq60_loans]) / SUM([eligible_loans])" /></column><column caption="Enough coverage" datatype="boolean" name="[Calc_cov]" role="dimension" type="nominal"><calculation class='tableau' formula="[eligible_loans] &gt;= 0.95 * [cohort_loans]" /></column><column-instance column="[months_on_book]" derivation="None" name="[none:months_on_book:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_rate]" derivation="User" name="[usr:Calc_rate:qk]" pivot='key' type="quantitative" /><column-instance column="[Calc_vintage]" derivation="None" name="[none:Calc_vintage:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_cov]" derivation="None" name="[none:Calc_cov:nk]" pivot='key' type="nominal" /></datasource-dependencies><filter class='categorical' column="[federated.curve].[none:Calc_cov:nk]"><groupfilter function='member' level="[none:Calc_cov:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.curve].[none:Calc_cov:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='axis'><format attr='title' class='0' field="[federated.curve].[none:months_on_book:qk]" scope="cols" value="Months on book (points with ≥95% of the quarter observed)" /><format attr='title' class='0' field="[federated.curve].[usr:Calc_rate:qk]" scope="rows" value="Cumulative 60+ delinquency rate" /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Line" /><encodings><color column="[federated.curve].[none:Calc_vintage:nk]" /></encodings></pane></panes><rows>[federated.curve].[usr:Calc_rate:qk]</rows><cols>[federated.curve].[none:months_on_book:qk]</cols></table></worksheet><worksheet name="Vintage by Segment"><layout-options><title><formatted-text><run bold='true' fontsize='13'>Cumulative 60+ rate at month 36, by loan attribute</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ads_vintage_dlq60_segment" name='federated.vseg' /></datasources><datasource-dependencies datasource='federated.vseg'><column datatype="string" name="[origination_year]" role="dimension" type="nominal" /><column datatype="string" name="[origination_quarter]" role="dimension" type="nominal" /><column datatype="integer" name="[months_on_book]" role="measure" type="quantitative" /><column datatype="string" name="[segment_type]" role="dimension" type="nominal" /><column datatype="string" name="[segment_value]" role="dimension" type="nominal" /><column datatype="integer" name="[cohort_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[eligible_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[cum_dlq60_loans]" role="measure" type="quantitative" /><column datatype="real" name="[cum_dlq60_rate]" role="measure" type="quantitative" /><column caption="60+ loans by month 36" datatype="integer" name="[Calc_m36_cum]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [months_on_book] = 36 THEN [cum_dlq60_loans] END" /></column><column caption="Loans observed 36 months" datatype="integer" name="[Calc_m36_elig]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [months_on_book] = 36 THEN [eligible_loans] END" /></column><column caption="Cum 60+ rate at month 36" datatype="real" default-format="p0.0%" name="[Calc_m36_rate]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Calc_m36_cum]) / SUM([Calc_m36_elig])" /></column><column-instance column="[segment_type]" derivation="None" name="[none:segment_type:nk]" pivot='key' type="nominal" /><column-instance column="[segment_value]" derivation="None" name="[none:segment_value:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_m36_rate]" derivation="User" name="[usr:Calc_m36_rate:qk]" pivot='key' type="quantitative" /></datasource-dependencies><filter class='categorical' column="[federated.vseg].[none:segment_type:nk]"><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level="[none:segment_type:nk]" /><groupfilter function='member' level="[none:segment_type:nk]" member='"STATE"' /></groupfilter></filter><slices><column>[federated.vseg].[none:segment_type:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='axis'><format attr='title' class='0' field="[federated.vseg].[usr:Calc_m36_rate:qk]" scope="cols" value="Cumulative 60+ rate at month 36" /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Bar" /><encodings><text column="[federated.vseg].[usr:Calc_m36_rate:qk]" /></encodings></pane></panes><rows>([federated.vseg].[none:segment_type:nk] / [federated.vseg].[none:segment_value:nk])</rows><cols>[federated.vseg].[usr:Calc_m36_rate:qk]</cols></table></worksheet><worksheet name="Re-default by Mod Year"><layout-options><title><formatted-text><run bold='true' fontsize='13'>12-month re-default rate after first modification</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="ads_modification_outcome" name='federated.mod' /></datasources><datasource-dependencies datasource='federated.mod'><column datatype="string" name="[origination_year]" role="dimension" type="nominal" /><column datatype="string" name="[first_mod_year]" role="dimension" type="nominal" /><column datatype="string" name="[before_mod_group]" role="dimension" type="nominal" /><column datatype="integer" name="[modified_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[observable_12m_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[redefault_12m_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[current_12m_loans]" role="measure" type="quantitative" /><column datatype="integer" name="[prepaid_12m_loans]" role="measure" type="quantitative" /><column datatype="real" name="[redefault_12m_rate]" role="measure" type="quantitative" /><column datatype="real" name="[current_12m_rate]" role="measure" type="quantitative" /><column caption="12-month re-default rate" datatype="real" default-format="p0.0%" name="[Calc_redef]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([redefault_12m_loans]) / SUM([observable_12m_loans])" /></column><column-instance column="[first_mod_year]" derivation="None" name="[none:first_mod_year:nk]" pivot='key' type="nominal" /><column-instance column="[before_mod_group]" derivation="None" name="[none:before_mod_group:nk]" pivot='key' type="nominal" /><column-instance column="[Calc_redef]" derivation="User" name="[usr:Calc_redef:qk]" pivot='key' type="quantitative" /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='axis'><format attr='title' class='0' field="[federated.mod].[usr:Calc_redef:qk]" scope="rows" value="Re-default within 12 months (loans observed 12 months)" /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class="Bar" /><encodings><color column="[federated.mod].[none:before_mod_group:nk]" /></encodings></pane></panes><rows>[federated.mod].[usr:Calc_redef:qk]</rows><cols>([federated.mod].[none:first_mod_year:nk] / [federated.mod].[none:before_mod_group:nk])</cols></table></worksheet><worksheet name="Re-default by Segment"><layout-options><title><formatted-text><run bold='true' fontsize='13'>12-month re-default rate after modification, by loan attribute</run></formatted-te